#!/usr/bin/env node
/**
 * my-code-style-init CLI
 *
 * Scaffolds lint/format/git config files into the current project.
 * Auto-detects ESLint version and CSS preprocessor for optimal config generation.
 *
 * Usage:
 *   npx my-code-style-init
 *   npx my-code-style-init --dry-run
 */

const fs = require("fs")
const path = require("path")

const PROJECT_ROOT = process.cwd()
const PACKAGE_DIR = path.resolve(__dirname, "..")

// --- Helpers ---

function log(msg) {
    console.log(`  ${msg}`)
}

function success(msg) {
    console.log(`  ✓ ${msg}`)
}

function warn(msg) {
    console.log(`  ⚠ ${msg}`)
}

function ensureDir(dirPath) {
    if (!fs.existsSync(dirPath)) {
        fs.mkdirSync(dirPath, { recursive: true })
    }
}

function writeFile(dest, content) {
    const destDir = path.dirname(dest)
    ensureDir(destDir)
    fs.writeFileSync(dest, content, "utf8")
}

function fileExists(relative) {
    return fs.existsSync(path.resolve(PROJECT_ROOT, relative))
}

function readTemplate(relativePath) {
    return fs.readFileSync(path.resolve(PACKAGE_DIR, relativePath), "utf8")
}

/**
 * Append an entry to the project .gitignore (idempotent, keeps existing lines).
 */
function ensureGitignoreEntry(entry) {
    const gitignorePath = path.resolve(PROJECT_ROOT, ".gitignore")
    if (!fs.existsSync(gitignorePath)) return
    const content = fs.readFileSync(gitignorePath, "utf8")
    const hasEntry = content.split("\n").some((line) => line.trim() === entry)
    if (hasEntry) return
    const separator = content.length === 0 || content.endsWith("\n") ? "" : "\n"
    fs.writeFileSync(
        gitignorePath,
        `${content}${separator}\n# my-code-style 初始化备份目录\n${entry}\n`,
        "utf8",
    )
}

function getProjectPkg() {
    const pkgPath = path.resolve(PROJECT_ROOT, "package.json")
    if (!fs.existsSync(pkgPath)) return null
    try {
        return JSON.parse(fs.readFileSync(pkgPath, "utf8"))
    } catch {
        return null
    }
}

function getDependencyVersion(pkg, depName) {
    return (
        (pkg.dependencies && pkg.dependencies[depName]) ||
        (pkg.devDependencies && pkg.devDependencies[depName]) ||
        (pkg.peerDependencies && pkg.peerDependencies[depName]) ||
        null
    )
}

// --- Detection helpers ---

/**
 * Detect if project is configured as ECMAScript Module (ESM)
 */
function isEsmProject(pkg = getProjectPkg()) {
    return pkg?.type === "module"
}

// --- Semver range helpers (dependency-free) ---
// Detection only needs to know which major versions a declared range can
// install. Regex guessing on the raw string misreads "<9.0.0" (8 only) and
// ">=8.0.0" (8 or 9), so ranges are parsed into half-open [lower, upper)
// intervals with the subset of npm range syntax that appears in practice.

const MAX_VERSION = [Number.POSITIVE_INFINITY, 0, 0]

function compareVersion(a, b) {
    for (let i = 0; i < 3; i += 1) {
        if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1
    }
    return 0
}

function isWildcardField(field) {
    return field === undefined || field === "" || /^[xX*]$/.test(field)
}

function parseVersionFields(text) {
    const [release] = String(text).trim().replace(/^v/, "").split("-")
    const fields = release.split(".")
    if (fields.length > 3) return null
    const parts = [0, 1, 2].map((index) => {
        const field = fields[index]
        if (isWildcardField(field)) return null
        return /^\d+$/.test(field) ? parseInt(field, 10) : NaN
    })
    return parts.some((part) => Number.isNaN(part)) ? null : parts
}

function lowerBound(parts) {
    return [parts[0] || 0, parts[1] || 0, parts[2] || 0]
}

function partialInterval(parts) {
    const lower = lowerBound(parts)
    const missing = parts.findIndex((part) => part === null)
    if (missing === -1) return [lower, [lower[0], lower[1], lower[2] + 1]]
    if (missing === 0) return [[0, 0, 0], MAX_VERSION]
    const upper = [0, 0, 0]
    for (let i = 0; i < missing; i += 1) upper[i] = parts[i]
    upper[missing - 1] += 1
    return [lower, upper]
}

function caretInterval(parts) {
    const lower = lowerBound(parts)
    if (parts[0] === null) return [[0, 0, 0], MAX_VERSION]
    if (parts[0] > 0 || parts[1] === null) return [lower, [parts[0] + 1, 0, 0]]
    if (parts[1] > 0 || parts[2] === null) return [lower, [0, parts[1] + 1, 0]]
    return [lower, [0, 0, parts[2] + 1]]
}

function tildeInterval(parts) {
    const lower = lowerBound(parts)
    if (parts[0] === null) return [[0, 0, 0], MAX_VERSION]
    if (parts[1] === null) return [lower, [parts[0] + 1, 0, 0]]
    return [lower, [parts[0], parts[1] + 1, 0]]
}

function tokenInterval(token) {
    const match = /^(>=|<=|>|<|\^|~|=)?\s*(.*)$/.exec(token.trim())
    if (!match || !match[2]) return null
    const [, operator = "", text] = match
    if (/^[xX*]$/.test(text.trim())) return [[0, 0, 0], MAX_VERSION]
    const parts = parseVersionFields(text)
    if (!parts) return null
    const lower = lowerBound(parts)
    switch (operator) {
        case ">=":
            return [lower, MAX_VERSION]
        case ">":
            return [[lower[0], lower[1], lower[2] + 1], MAX_VERSION]
        case "<":
            return [[0, 0, 0], lower]
        case "<=":
            return [
                [0, 0, 0],
                [lower[0], lower[1], lower[2] + 1],
            ]
        case "^":
            return caretInterval(parts)
        case "~":
            return tildeInterval(parts)
        default:
            return partialInterval(parts)
    }
}

function rangeIntervals(range) {
    const intervals = []
    for (const clause of range.split("||")) {
        const text = clause.trim()
        if (!text) continue
        const hyphen = text.split(/\s+-\s+/)
        const tokens =
            hyphen.length === 2 ? [`>=${hyphen[0]}`, `<=${hyphen[1]}`] : text.split(/\s+/)
        let lower = [0, 0, 0]
        let upper = MAX_VERSION
        let valid = true
        for (const token of tokens) {
            const interval = tokenInterval(token)
            if (!interval) {
                valid = false
                break
            }
            if (compareVersion(interval[0], lower) > 0) lower = interval[0]
            if (compareVersion(interval[1], upper) < 0) upper = interval[1]
        }
        if (valid && compareVersion(lower, upper) < 0) intervals.push([lower, upper])
    }
    return intervals
}

/**
 * 判断某个具体版本（含 minor / patch）是否落在声明的范围内。
 *
 * 为什么不用主版本判断：`vue-eslint-parser ^10.3.0` 与装到的 10.2.0 主版本相同，
 * 但 10.3 才是 Vue 插件 10 的兼容下限，只比主版本会漏掉这类 minor 级错位。
 * 这里直接做区间相交判断，既不受主版本位数限制（stylelint 16/17），也不丢 minor。
 * 返回 null 表示范围无法解析（不判断）。
 */
function satisfiesRange(range, version) {
    const parts = parseVersionFields(version)
    if (!parts || parts.some((part) => part === null)) return null
    const target = lowerBound(parts)
    const intervals = rangeIntervals(range)
    if (!intervals.length) return null
    return intervals.some(
        ([lower, upper]) => compareVersion(lower, target) <= 0 && compareVersion(target, upper) < 0,
    )
}

/**
 * List every major version a declared range can install (0-12), or null when
 * the range cannot be parsed.
 */
function majorsForRange(range) {
    const intervals = rangeIntervals(range)
    if (!intervals.length) return null
    const majors = []
    for (let major = 0; major <= 12; major += 1) {
        const lower = [major, 0, 0]
        const upper = [major + 1, 0, 0]
        const intersects = intervals.some(
            ([intervalLower, intervalUpper]) =>
                compareVersion(intervalLower, upper) < 0 &&
                compareVersion(intervalUpper, lower) > 0,
        )
        if (intersects) majors.push(major)
    }
    return majors.length ? majors : null
}

/**
 * 读取任意包在本项目（或向上寻找的“工作区根”）里实际安装的版本。
 * monorepo 里依赖常被提升到工作区根，所以要向上走；只采纳项目根或带
 * manifest 的祖先目录，避免把无关上级目录的 node_modules 当成本项目依赖。
 */
function findInstalledPackage(pkgName, rootDir) {
    let dir = rootDir
    for (let depth = 0; depth < 8; depth += 1) {
        const isProjectRoot = dir === rootDir
        const isWorkspaceRoot =
            fs.existsSync(path.resolve(dir, "package.json")) ||
            fs.existsSync(path.resolve(dir, "pnpm-workspace.yaml")) ||
            fs.existsSync(path.resolve(dir, "lerna.json"))

        if (isProjectRoot || isWorkspaceRoot) {
            try {
                const manifestPath = path.resolve(
                    dir,
                    "node_modules",
                    ...pkgName.split("/"),
                    "package.json",
                )
                if (fs.existsSync(manifestPath)) {
                    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"))
                    if (manifest.version) {
                        return { version: String(manifest.version), dir, manifest }
                    }
                }
            } catch {
                // 忽略读不动的安装（半装状态），继续向上找
            }
        }

        const parent = path.dirname(dir)
        if (parent === dir) break
        dir = parent
    }
    return null
}

/**
 * 读取实际安装的 ESLint 主版本号（见 findInstalledPackage 的查找规则）。
 */
function findInstalledEslintMajor(rootDir) {
    const installed = findInstalledPackage("eslint", rootDir)
    if (!installed) return null
    const major = parseInt(String(installed.version).split(".")[0], 10)
    return Number.isNaN(major) ? null : major
}

/**
 * Detect ESLint major version from the installed package or the declared range.
 * Returns 8, 9, 10, … or null (not installed and no usable range).
 */
function detectEslintVersion(pkg = getProjectPkg(), rootDir = PROJECT_ROOT) {
    if (!pkg) return null

    // 1. If eslint is installed in node_modules (or hoisted to the workspace root),
    //    read its actual major version directly
    const installedMajor = findInstalledEslintMajor(rootDir)
    if (installedMajor !== null) {
        return installedMajor
    }

    // 2. Parse package.json dependency declaration
    let version = getDependencyVersion(pkg, "eslint")
    if (!version || typeof version !== "string") return null

    version = version.trim()

    // Handle npm alias: e.g. "npm:eslint@^8.57.0"
    if (version.startsWith("npm:")) {
        const atIdx = version.lastIndexOf("@")
        if (atIdx > 3) {
            version = version.slice(atIdx + 1).trim()
        }
    }

    // Handle workspace protocol: e.g. "workspace:^8.0.0", "workspace:*"
    if (version.startsWith("workspace:")) {
        version = version.slice("workspace:".length).trim()
        if (version === "*" || version === "^" || version === "~") {
            return null
        }
    }

    // Unspecified or dynamic ranges
    if (
        version === "*" ||
        version === "" ||
        version.startsWith("catalog:") ||
        version.startsWith("file:") ||
        version.startsWith("link:")
    ) {
        return null
    }

    // npm tag: latest
    if (version === "latest") {
        return 9
    }

    const majors = majorsForRange(version)
    if (!majors) {
        // Fallback: check leading digit if available
        const match = version.match(/(\d+)/)
        return match ? parseInt(match[1], 10) : null
    }

    // Ranges such as ">=8.0.0" or "^8.57.0 || ^9.0.0" can install either
    // major; without a local install npm resolves the newest one (9).
    if (majors.includes(8) && majors.includes(9)) {
        log("ESLint 依赖同时支持 8 与 9 且未安装本地副本，默认采用 ESLint 9 Flat Config")
        return 9
    }
    if (majors.includes(9)) return 9
    if (majors.includes(8)) return 8
    return majors[0]
}

/**
 * Detect if project is a uni-app project
 */
function isUniAppProject() {
    const pkg = getProjectPkg()
    if (!pkg) return false
    const allDeps = {
        ...(pkg.dependencies || {}),
        ...(pkg.devDependencies || {}),
        ...(pkg.peerDependencies || {}),
    }
    return !!(allDeps["@dcloudio/uni-app"] || allDeps["uni-app"])
}

/**
 * Detect if project is a Vue project
 */
function isVueProject() {
    const pkg = getProjectPkg()
    if (!pkg) return false
    const allDeps = {
        ...(pkg.dependencies || {}),
        ...(pkg.devDependencies || {}),
        ...(pkg.peerDependencies || {}),
    }
    return !!(allDeps["vue"] || allDeps["@dcloudio/uni-app"] || allDeps["uni-app"])
}

/**
 * Detect the package manager in use ("pnpm" | "npm" | "yarn" | "bun" | null).
 * The lockfile is the project's own truth, so it wins over the user agent of
 * whatever launched this CLI (e.g. `npx` inside a pnpm project).
 */
function detectPackageManager() {
    if (fileExists("pnpm-lock.yaml")) return "pnpm"
    if (fileExists("yarn.lock")) return "yarn"
    if (fileExists("bun.lockb") || fileExists("bun.lock")) return "bun"
    if (fileExists("package-lock.json")) return "npm"

    const agent = process.env.npm_config_user_agent || ""
    if (agent.startsWith("pnpm/")) return "pnpm"
    if (agent.startsWith("yarn/")) return "yarn"
    if (agent.startsWith("bun/")) return "bun"
    if (agent.startsWith("npm/")) return "npm"
    return null
}

function addDevCommand(packageManager) {
    switch (packageManager) {
        case "npm":
            return "npm i -D"
        case "yarn":
            return "yarn add -D"
        case "bun":
            return "bun add -d"
        default:
            return "pnpm add -D"
    }
}

// 步骤标题行：CJK 字符按 2 列计宽，右侧补齐横线，让每个步骤标题线等长
function displayWidth(text) {
    let width = 0
    for (const ch of text) {
        width += ch.codePointAt(0) > 0xff ? 2 : 1
    }
    return width
}

function stepHeader(current, total, title) {
    const head = `步骤 ${current}/${total} · ${title}`
    const pad = Math.max(4, 46 - displayWidth(head))
    console.log(`\n  ── ${head} ${"─".repeat(pad)}`)
}

// 打印安装规格时按需加引号：`name@range` 里含 || 或 >= 等字符会被 shell 当成
// 管道/重定向，把整条命令截断（stylelint@^16.24.0 || ^17.0.0 原样粘贴必炸）。
// 规格含安全字符集（字母数字 @ / . _ ^ ~ -）之外的任何字符就整体包一层双引号。
function shellSafeSpec(spec) {
    return /[^A-Za-z0-9@/._^~-]/.test(spec) ? `"${spec}"` : spec
}

/**
 * `pnpm prepare` / `yarn prepare` run the script directly, but npm needs an
 * explicit `npm run prepare` (plain `npm prepare` is not a command).
 */
function runScriptCommand(packageManager, script) {
    switch (packageManager) {
        case "npm":
        case "bun":
            return `${packageManager} run ${script}`
        default:
            return `${packageManager} ${script}`
    }
}

/**
 * Detect project type: "uniapp", "vue", or "base"
 */
function detectProjectType() {
    if (isUniAppProject()) return "uniapp"
    if (isVueProject()) return "vue"
    return "base"
}

/**
 * Detect CSS preprocessor in use
 * Returns "scss", "less", "both", or "none"
 */
function detectCssPreprocessor() {
    const pkg = getProjectPkg()
    const allDeps = pkg
        ? {
              ...(pkg.dependencies || {}),
              ...(pkg.devDependencies || {}),
              ...(pkg.peerDependencies || {}),
          }
        : {}

    const hasSass = allDeps["sass"] || allDeps["node-sass"] || allDeps["sass-loader"]
    const hasLess = allDeps["less"] || allDeps["less-loader"]

    if (hasSass && hasLess) return "both"
    if (hasLess && !hasSass) return "less"
    if (hasSass) return "scss"

    // Fallback: check for existing stylelint config
    if (fileExists(".stylelintrc.cjs") || fileExists(".stylelintrc.js")) {
        const stylelintFile = fileExists(".stylelintrc.cjs")
            ? ".stylelintrc.cjs"
            : ".stylelintrc.js"
        let content = ""
        try {
            content = fs.readFileSync(path.resolve(PROJECT_ROOT, stylelintFile), "utf8")
        } catch {}
        // "my-code-style/stylelint" is a prefix of "my-code-style/stylelint/less",
        // so the Less entry must be matched before the SCSS one.
        const usesLess =
            /my-code-style\/stylelint\/less(?:-override)?/.test(content) ||
            content.includes("postcss-less") ||
            content.includes("stylelint-config-recommended-less")
        const usesScss =
            /my-code-style\/stylelint(?![-\w/])/.test(content) ||
            content.includes("postcss-scss") ||
            content.includes("stylelint-config-recommended-scss")
        if (usesLess && usesScss) return "both"
        if (usesLess) return "less"
        if (usesScss) return "scss"
        return "scss"
    }

    // 无 package.json 时无法判断项目类型，不猜测样式方案（避免凭空安装一堆 stylelint 依赖）
    if (!pkg) {
        return "none"
    }

    // If not a Vue/uni-app project and no css preprocessor found, skip stylelint
    if (!isVueProject()) {
        return "none"
    }

    return "scss" // default for Vue/uni-app projects
}

// --- Config templates ---

function eslintrcContent(projectType) {
    let importPath = "my-code-style/eslint"
    if (projectType === "uniapp") {
        importPath = "my-code-style/eslint/uniapp"
    } else if (projectType === "vue") {
        importPath = "my-code-style/eslint/vue3"
    }

    return `// ESLint config — powered by my-code-style
// https://www.npmjs.com/package/my-code-style
const config = require("${importPath}")

// 如果需要引入 unplugin-auto-import 生成的 globals，取消下面的注释：
// config.extends = [...config.extends, "./.eslintrc-auto-import.json"]

module.exports = config
`
}

function eslintFlatConfigContent(projectType) {
    let importPath = "my-code-style/eslint/flat"
    let varName = "baseConfig"
    if (projectType === "uniapp") {
        importPath = "my-code-style/eslint/flat/uniapp"
        varName = "uniappConfig"
    } else if (projectType === "vue") {
        importPath = "my-code-style/eslint/flat/vue3"
        varName = "vue3Config"
    }

    return `// ESLint Flat Config — powered by my-code-style
// https://www.npmjs.com/package/my-code-style
import ${varName} from "${importPath}"

export default [...${varName}]
`
}

function prettierrcContent() {
    return `// Prettier config — powered by my-code-style
module.exports = require("my-code-style/prettier")
`
}

function prettierignoreContent() {
    return readTemplate("src/prettierignore")
}

function stylelintrcContent(cssPreprocessor) {
    const importPath =
        cssPreprocessor === "less" ? "my-code-style/stylelint/less" : "my-code-style/stylelint"

    return `// Stylelint config — powered by my-code-style
module.exports = require("${importPath}")
`
}

function commitlintrcContent() {
    const mockScope = ["mock", "mocks", "src/mock", "src/mocks"].some((dir) =>
        fs.existsSync(path.resolve(PROJECT_ROOT, dir)),
    )
        ? `, "mock"`
        : ""
    return `// Commitlint config — powered by my-code-style
const base = require("my-code-style/commitlint")
const { generateScopes, guessCurrentScope } = require("my-code-style/commitlint/scopes")

const scopes = generateScopes("src")
const scopeComplete = guessCurrentScope()

module.exports = {
    ...base,
    prompt: {
        ...base.prompt,
        customScopesAlign: !scopeComplete ? "top" : "bottom",
        defaultScope: scopeComplete,
        scopes: [...scopes${mockScope}],
        allowEmptyIssuePrefixs: false,
        allowCustomIssuePrefixs: false,
    },
}
`
}

function versionrcContent() {
    return `// commit-and-tag-version config — powered by my-code-style
module.exports = require("my-code-style/versionrc")
`
}

// Hook bodies live in src/husky/* so the shipped templates cannot drift from
// what the CLI writes. Normalise the trailing newline.
function huskyCommitMsg() {
    return readTemplate("src/husky/commit-msg").replace(/\s*$/, "\n")
}

function huskyPreCommit() {
    return readTemplate("src/husky/pre-commit").replace(/\s*$/, "\n")
}

function editorconfigContent() {
    return readTemplate("src/editorconfig")
}

function gitattributesContent() {
    return readTemplate("src/gitattributes")
}

function gitignoreContent() {
    return readTemplate("src/gitignore")
}

/**
 * Generate the lint-staged config based on detected CSS preprocessor
 */
function getLintStagedConfig(cssPreprocessor) {
    // Disjoint groups: a file is owned by exactly one task array.
    // lint-staged runs each array in order, while unrelated groups may run concurrently.
    const componentTasks = ["prettier --write", "eslint --fix"]
    const styleTasks = ["prettier --write"]
    if (cssPreprocessor !== "none") {
        componentTasks.push("stylelint --fix")
        styleTasks.push("stylelint --fix")
    }
    const styleFiles =
        cssPreprocessor === "both"
            ? "**/*.{html,css,scss,less}"
            : cssPreprocessor === "less"
              ? "**/*.{html,css,less}"
              : cssPreprocessor === "scss"
                ? "**/*.{html,css,scss}"
                : "**/*.{html,css}"
    const config = {
        "**/*.{vue,nvue}": componentTasks,
        "**/*.{js,ts,jsx,tsx,cjs,mjs,mts,cts}": ["prettier --write", "eslint --fix"],
        [styleFiles]: styleTasks,
        "**/*.{json,json5,md,yml,yaml}": ["prettier --write"],
    }

    return config
}

// --- Main ---

function main() {
    const args = process.argv.slice(2)
    const supported = new Set([
        "--dry-run",
        "--backup",
        "--merge",
        "--no-overwrite",
        "--version",
        "-v",
        "--help",
        "-h",
    ])
    const unknown = args.filter((arg) => !supported.has(arg))
    if (unknown.length) {
        console.error(`未知参数: ${unknown.join(", ")}；使用 --help 查看帮助`)
        process.exitCode = 1
        return
    }
    if (args.includes("--help") || args.includes("-h")) {
        console.log(
            "Usage: my-code-style-init [--dry-run] [--backup] [--merge] [--version|-v] [--help|-h]",
        )
        console.log("  --backup   覆盖已有配置前将其备份到 .my-code-style-backup/ 目录")
        console.log("  --dry-run  试运行，仅输出将执行的变更，不写入任何文件")
        console.log(
            "  --merge    合并模式：已存在的配置一律保留，只补缺失文件（别名 --no-overwrite）",
        )
        console.log("  结束时自动自检 hooks（存在 / 可执行 / 命令可解析），仅提示不阻断")
        console.log("初始化会覆盖部分配置和 hooks；请先备份并运行 --dry-run。")
        return
    }

    // Handle --version / -v
    if (process.argv.includes("--version") || process.argv.includes("-v")) {
        const pkg = require("../package.json")
        console.log(pkg.version)
        return
    }

    // Validate before detection or any filesystem writes. Missing package.json
    // remains supported, but malformed manifests must never be treated as empty.
    if (fileExists("package.json")) {
        try {
            const pkg = JSON.parse(
                fs.readFileSync(path.resolve(PROJECT_ROOT, "package.json"), "utf8"),
            )
            if (!pkg || typeof pkg !== "object" || Array.isArray(pkg)) {
                throw new Error("package.json 必须是 JSON 对象")
            }
            for (const key of ["dependencies", "devDependencies", "peerDependencies", "scripts"]) {
                if (pkg[key] === undefined) continue
                if (
                    !pkg[key] ||
                    typeof pkg[key] !== "object" ||
                    Array.isArray(pkg[key]) ||
                    Object.values(pkg[key]).some((value) => typeof value !== "string")
                ) {
                    throw new Error(`${key} 必须是值为字符串的对象`)
                }
            }
        } catch (error) {
            console.error(`无法读取有效的 package.json：${error.message}；未修改任何文件`)
            process.exitCode = 1
            return
        }
    }

    const dryRun = process.argv.includes("--dry-run")

    let toolVersion = ""
    try {
        toolVersion = ` v${require("../package.json").version}`
    } catch {}

    console.log("")
    console.log(`  my-code-style-init${toolVersion} — 把 my-code-style 接入当前项目`)
    if (dryRun) {
        console.log("")
        warn("Dry run 预览模式：以下所有步骤都不会写入文件")
    }

    // --- Detection phase ---
    const pm = detectPackageManager() || "pnpm"
    const eslintVersion = detectEslintVersion()
    const cssPreprocessor = detectCssPreprocessor()
    const projectType = detectProjectType()

    // Determine ESLint format
    const hasLegacyConfigFile =
        fileExists(".eslintrc.js") ||
        fileExists(".eslintrc.cjs") ||
        fileExists(".eslintrc.json") ||
        fileExists(".eslintrc.yaml") ||
        fileExists(".eslintrc.yml") ||
        fileExists(".eslintrc")

    const hasFlatConfigFile =
        fileExists("eslint.config.mjs") ||
        fileExists("eslint.config.js") ||
        fileExists("eslint.config.ts") ||
        fileExists("eslint.config.cjs")

    if (eslintVersion !== null && eslintVersion < 8) {
        console.error(
            `不支持 ESLint ${eslintVersion} 版本；本配置包仅支持 ESLint 8 / 9 / 10，未修改任何文件`,
        )
        process.exitCode = 1
        return
    }

    const eslintUnannounced = eslintVersion !== null && eslintVersion > 10

    // Do not silently mix an installed major version with an incompatible format.
    if (
        (eslintVersion >= 9 && hasLegacyConfigFile && !hasFlatConfigFile) ||
        (eslintVersion === 8 && hasFlatConfigFile)
    ) {
        console.error("ESLint 版本与已有配置格式冲突；请先手动迁移或确认配置格式，未修改任何文件")
        process.exitCode = 1
        return
    }
    if (!eslintVersion && hasLegacyConfigFile && !hasFlatConfigFile) {
        console.error(
            "检测到传统 ESLint 配置但无法确定版本；请先声明 ESLint 版本或迁移到 Flat Config，未修改任何文件",
        )
        process.exitCode = 1
        return
    }
    const useFlatConfig = eslintVersion !== 8
    const eslintFormat = useFlatConfig ? "flat" : "eslintrc"

    stepHeader(1, 6, "检测项目环境")
    console.log(`      · 包管理器：${pm}`)
    console.log(
        `      · ESLint：${eslintVersion || "未声明，按已安装版本处理"} → ${eslintFormat === "flat" ? "Flat Config" : "传统 .eslintrc 格式"}`,
    )
    console.log(
        `      · 项目类型：${projectType === "uniapp" ? "uni-app" : projectType === "vue" ? "Vue" : "Node/TS 基础库"}`,
    )
    console.log(
        `      · CSS 预处理器：${cssPreprocessor === "both" ? "SCSS + Less（混合）" : cssPreprocessor === "none" ? "未检测到" : cssPreprocessor}`,
    )
    if (eslintUnannounced) {
        warn(
            `ESLint ${eslintVersion} 尚未在 peerDependencies 声明支持（^8.57.0 || ^9.0.0 || ^10.0.0），将按 Flat Config 生成`,
        )
    }

    // --- Build file list based on detection ---
    const files = []
    let skipStylelint = false

    stepHeader(2, 6, "ESLint 入口")
    if (hasFlatConfigFile || hasLegacyConfigFile) {
        console.log("      保留已有 ESLint 配置，不生成额外入口")
    } else if (useFlatConfig) {
        console.log("      生成 Flat Config 入口 eslint.config.mjs")
        files.push({
            path: "eslint.config.mjs",
            exists:
                fileExists("eslint.config.mjs") ||
                fileExists("eslint.config.js") ||
                fileExists("eslint.config.ts") ||
                fileExists("eslint.config.cjs"),
            content: eslintFlatConfigContent(projectType),
        })
    } else {
        console.log("      生成传统格式入口 .eslintrc.cjs")
        files.push({
            path: ".eslintrc.cjs",
            exists: fileExists(".eslintrc.cjs"),
            content: eslintrcContent(projectType),
        })
    }

    files.push({
        path: ".prettierrc.cjs",
        exists: fileExists(".prettierrc.cjs"),
        content: prettierrcContent(),
    })

    files.push({
        path: ".prettierignore",
        exists: fileExists(".prettierignore"),
        content: prettierignoreContent(),
    })

    // Stylelint: always generate, but note if no CSS preprocessor
    if (cssPreprocessor !== "none") {
        files.push({
            path: ".stylelintrc.cjs",
            exists: fileExists(".stylelintrc.cjs"),
            content: stylelintrcContent(cssPreprocessor),
        })
    } else {
        skipStylelint = true
    }

    files.push({
        path: ".commitlintrc.cjs",
        exists: fileExists(".commitlintrc.cjs"),
        content: commitlintrcContent(),
    })

    const isEsm = isEsmProject()
    let versionrcPath = ".versionrc.js"
    if (fileExists(".versionrc.cjs") || isEsm) {
        versionrcPath = ".versionrc.cjs"
    }

    const staleVersionrc = isEsm && fileExists(".versionrc.js") && !fileExists(".versionrc.cjs")
    // 发布工具读配置的顺序是 ['.versionrc', '.versionrc.cjs', '.versionrc.json', '.versionrc.js']：
    // 无扩展名或 .json 的旧文件会压过本次生成的 .versionrc.cjs（实测 standard-version 9.5 / catv 均如此）
    const staleVersionrcTop = [".versionrc", ".versionrc.json"].filter((f) => fileExists(f))

    files.push({
        path: versionrcPath,
        exists: fileExists(versionrcPath),
        content: versionrcContent(),
    })

    files.push({
        path: ".editorconfig",
        exists: fileExists(".editorconfig"),
        content: editorconfigContent(),
    })

    files.push({
        path: ".gitattributes",
        exists: fileExists(".gitattributes"),
        content: gitattributesContent(),
    })

    if (!fileExists(".gitignore")) {
        files.push({
            path: ".gitignore",
            exists: false,
            content: gitignoreContent(),
        })
    }

    const backup = args.includes("--backup")
    const mergeMode = args.includes("--merge") || args.includes("--no-overwrite")
    stepHeader(3, 6, "配置文件与 Git hooks")
    let overwriteTotal = 0
    let createTotal = 0
    for (const f of files) {
        if (f.exists) {
            overwriteTotal++
            console.log(`      覆盖 ${f.path}`)
        } else {
            createTotal++
            console.log(`      新建 ${f.path}`)
        }
    }

    // Husky hooks
    const huskyDir = path.resolve(PROJECT_ROOT, ".husky")
    const hasHusky = fs.existsSync(huskyDir)
    if (!hasHusky) {
        console.log("      新建 .husky/ 目录")
    }

    const hooks = [
        { path: ".husky/commit-msg", content: huskyCommitMsg() },
        { path: ".husky/pre-commit", content: huskyPreCommit() },
    ]

    for (const h of hooks) {
        if (fileExists(h.path)) {
            overwriteTotal++
            console.log(`      覆盖 ${h.path}`)
        } else {
            createTotal++
            console.log(`      新建 ${h.path}`)
        }
    }

    console.log(
        `      小计：覆盖 ${overwriteTotal} 个 · 新建 ${createTotal} 个` +
            (backup ? " · 旧文件将备份到 .my-code-style-backup/" : "") +
            (dryRun ? "（Dry run 预览，不写入）" : ""),
    )
    if (skipStylelint) {
        console.log("      · 跳过 .stylelintrc.cjs（未检测到 CSS 预处理器）")
    }
    if (staleVersionrc) {
        warn(
            "检测到 ESM 项目 (type: module) 存在旧的 .versionrc.js，发布工具需要使用 .versionrc.cjs",
        )
    }
    if (staleVersionrcTop.length > 0) {
        warn(
            `检测到 ${staleVersionrcTop.join("、")}：发布工具会优先读取它，本次生成的 .versionrc.cjs 不会生效；请把配置合并进来或删除旧文件`,
        )
    }

    const printPackageJsonStep = () => {
        stepHeader(4, 6, "package.json")
        if (dryRun) {
            console.log(
                "      · 将更新 scripts（lint / lint:fix / format / prepare / release / cz）与 lint-staged",
            )
            return
        }
        console.log("      ✓ scripts 已更新（lint / lint:fix / format / prepare / release / cz）")
        console.log("      ✓ lint-staged 已按检测到的 CSS 预处理器生成")
    }

    const printDepsStep = () => {
        stepHeader(5, 6, "依赖体检")
        const findings = checkPeerDeps({ useFlatConfig, cssPreprocessor, projectType })
        if (findings === 0) {
            console.log("      ✓ 已装依赖版本都在要求范围内，声明的依赖也都已安装")
        }
    }

    const printFooter = () => {
        stepHeader(6, 6, "接下来")
        console.log(`      1. 启用 husky hooks：${runScriptCommand(pm, "prepare")}`)
        console.log(`      2. 首次检查：${runScriptCommand(pm, "lint")}`)
        console.log("      3. 使用 czg 提交 commit：")
        console.log(`         ${runScriptCommand(pm, "cz")}`)
        console.log(
            "         （先 git add 暂存改动；交互步骤、类型与 scope 规则见本包 README《用 pnpm cz 提交》）",
        )
        if (pm === "pnpm") {
            console.log("")
            console.log(
                "      提示：pnpm 10+ 默认拦截依赖的构建脚本，若安装时提示 ERR_PNPM_IGNORED_BUILDS（如 unrs-resolver），执行 pnpm approve-builds 后重试。",
            )
        }
        console.log("")
        if (dryRun) {
            success("Dry run 结束：未写入任何文件；去掉 --dry-run 执行真实初始化")
        } else {
            success(
                `初始化完成：覆盖 ${overwriteTotal} 个 · 新建 ${createTotal} 个 · package.json 已更新`,
            )
        }
        console.log("")
    }

    // Dry run：把 package.json / 依赖体检 / 下一步三步也预览出来，然后结束
    if (dryRun) {
        printPackageJsonStep()
        printDepsStep()
        printFooter()
        return
    }

    // Optional backup of existing files before modifying
    const backupDir = path.resolve(PROJECT_ROOT, ".my-code-style-backup")
    let backedUpCount = 0
    if (backup) {
        ensureDir(backupDir)
        // package.json is rewritten (scripts + lint-staged), so it must be backed
        // up as well — users lose custom lint-staged groups otherwise.
        for (const item of [...files, ...hooks, { path: "package.json" }]) {
            // --merge 不覆盖已有文件，无需为其备份（package.json 例外：scripts 仍会补齐）
            if (mergeMode && item.path !== "package.json") continue
            if (fileExists(item.path)) {
                const srcPath = path.resolve(PROJECT_ROOT, item.path)
                const targetPath = path.resolve(backupDir, item.path)
                ensureDir(path.dirname(targetPath))
                fs.copyFileSync(srcPath, targetPath)
                backedUpCount++
            }
        }
        // 与本次生成的 .versionrc.cjs 抢生效顺序的同名旧配置（.versionrc /
        // .versionrc.json 会直接压过生成物，ESM 项目的 .versionrc.js 徒增歧义）：
        // 备份后移除，不留"哪份在生效"的悬案（下游升级实测 D2）
        // --merge 不动用户已有配置：stale 文件保持原样（前面已给出告警）
        const staleVersionrcFiles = mergeMode
            ? []
            : [...staleVersionrcTop, ...(staleVersionrc ? [".versionrc.js"] : [])]
        for (const relPath of staleVersionrcFiles) {
            if (!fileExists(relPath)) continue
            const staleSrc = path.resolve(PROJECT_ROOT, relPath)
            const staleTarget = path.resolve(backupDir, relPath)
            ensureDir(path.dirname(staleTarget))
            fs.copyFileSync(staleSrc, staleTarget)
            fs.rmSync(staleSrc)
            backedUpCount++
            console.log(
                `      · 旧 ${relPath} 已备份到 .my-code-style-backup/ 并移除（由 ${versionrcPath} 接管）`,
            )
        }
    }

    // ESLint 8 directory traversal defaults to .js; explicitly include typed
    // files and the selected component formats so `lint` cannot silently skip them.
    const legacyExtensions =
        ".js,.cjs,.mjs,.ts,.mts,.cts,.jsx,.tsx" +
        (projectType !== "base" ? ",.vue" : "") +
        (projectType === "uniapp" ? ",.nvue" : "")
    const lintCommand = useFlatConfig ? "eslint ." : `eslint . --ext ${legacyExtensions}`

    // Take snapshot of files and hooks before making any filesystem modifications
    const snapshot = new Map()
    for (const f of files) {
        const abs = path.resolve(PROJECT_ROOT, f.path)
        let existed = false
        let isFile = false
        let content = null
        try {
            if (fs.existsSync(abs)) {
                existed = true
                isFile = fs.statSync(abs).isFile()
                if (isFile) content = fs.readFileSync(abs, "utf8")
            }
        } catch {}
        snapshot.set(f.path, { existed, isFile, content })
    }
    for (const h of hooks) {
        const abs = path.resolve(PROJECT_ROOT, h.path)
        let existed = false
        let isFile = false
        let content = null
        let mode = undefined
        try {
            if (fs.existsSync(abs)) {
                existed = true
                const stat = fs.statSync(abs)
                isFile = stat.isFile()
                mode = stat.mode
                if (isFile) content = fs.readFileSync(abs, "utf8")
            }
        } catch {}
        snapshot.set(h.path, { existed, isFile, content, mode })
    }
    const pkgPath = path.resolve(PROJECT_ROOT, "package.json")
    const hadPkg = fs.existsSync(pkgPath)
    let pkgContent = null
    try {
        if (hadPkg && fs.statSync(pkgPath).isFile()) {
            pkgContent = fs.readFileSync(pkgPath, "utf8")
        }
    } catch {}
    const hadHuskyDir = fs.existsSync(huskyDir)

    try {
        // Actually write files
        for (const f of files) {
            if (mergeMode && snapshot.get(f.path)?.existed) {
                console.log(`      · 保留 ${f.path}（--merge 不覆盖）`)
                continue
            }
            writeFile(f.path, f.content)
        }

        // Husky
        if (!hasHusky) {
            ensureDir(huskyDir)
        }
        for (const h of hooks) {
            if (mergeMode && snapshot.get(h.path)?.existed) {
                console.log(`      · 保留 ${h.path}（--merge 不覆盖）`)
                continue
            }
            writeFile(h.path, h.content)
            fs.chmodSync(path.resolve(PROJECT_ROOT, h.path), 0o755)
        }

        // package.json scripts + lint-staged
        modifyPackageJson(
            {
                scripts: {
                    lint: lintCommand,
                    "lint:fix": `${lintCommand} --fix`,
                    format: "prettier --write .",
                    prepare: "husky",
                    release: "commit-and-tag-version",
                    cz: "czg",
                },
                "lint-staged": getLintStagedConfig(cssPreprocessor),
            },
            { merge: mergeMode },
        )
        printPackageJsonStep()
        if (!dryRun) {
            verifyGeneratedHooks(hooks)
        }

        // The backup directory is ours, not the user's source — keep it out of git
        if (backup) {
            ensureGitignoreEntry(".my-code-style-backup/")
            console.log(
                `      ✓ ${backedUpCount} 个旧文件已备份到 .my-code-style-backup/（目录已写入 .gitignore）`,
            )
        }
    } catch (err) {
        console.error(`\n  ✖ 初始化写入失败: ${err.message}；正在回滚...`)
        for (const [relPath, info] of snapshot.entries()) {
            const abs = path.resolve(PROJECT_ROOT, relPath)
            try {
                if (info.existed && info.isFile) {
                    fs.writeFileSync(abs, info.content, "utf8")
                    if (info.mode !== undefined) {
                        fs.chmodSync(abs, info.mode)
                    }
                } else if (!info.existed && fs.existsSync(abs)) {
                    fs.rmSync(abs, { force: true, recursive: true })
                }
            } catch (rollbackErr) {
                console.error(`  回滚文件失败: ${relPath} (${rollbackErr.message})`)
            }
        }
        if (hadPkg) {
            fs.writeFileSync(pkgPath, pkgContent, "utf8")
        } else if (fs.existsSync(pkgPath)) {
            fs.rmSync(pkgPath, { force: true })
        }
        if (!hadHuskyDir && fs.existsSync(huskyDir)) {
            try {
                if (fs.readdirSync(huskyDir).length === 0) {
                    fs.rmdirSync(huskyDir)
                }
            } catch {}
        }
        console.error("  ✓ 已成功回滚所有更改，工作区已恢复原始状态。\n")
        process.exitCode = 1
        return
    }

    printDepsStep()
    printFooter()
}

// init 收尾 hook 自检（issue #8）：存在 / 非空 / 可执行位 / 引用命令可解析。
// 只报告不阻断——真实提交链路才是最终裁判，这里负责把"装了但没用"提前亮出来。
function verifyGeneratedHooks(hooks) {
    console.log("      · hook 自检")
    let pkg = {}
    try {
        pkg = JSON.parse(fs.readFileSync(path.resolve(PROJECT_ROOT, "package.json"), "utf8"))
    } catch {}
    for (const h of hooks) {
        const abs = path.resolve(PROJECT_ROOT, h.path)
        if (!fileExists(abs)) {
            warn(`${h.path} 缺失`)
            continue
        }
        const content = fs.readFileSync(abs, "utf8")
        if (!content.trim()) {
            warn(`${h.path} 内容为空，git 将静默跳过`)
            continue
        }
        if ((fs.statSync(abs).mode & 0o111) === 0) {
            warn(`${h.path} 缺少可执行位，git 会静默忽略（chmod +x 修复）`)
        }
        for (const cmd of ["lint-staged", "commitlint"]) {
            if (!content.includes(cmd)) continue
            const localBin = fs.existsSync(path.join(PROJECT_ROOT, "node_modules", ".bin", cmd))
            const declared = Boolean(pkg.devDependencies?.[cmd] ?? pkg.dependencies?.[cmd])
            if (!localBin && !declared) {
                warn(`${h.path} 引用的 ${cmd} 未安装：安装依赖前提交会因 npx --no-install 失败`)
            }
        }
    }
    if (!fs.existsSync(path.join(PROJECT_ROOT, ".husky", "_"))) {
        console.log("      · 提示：.husky/_ 未生成，安装依赖（触发 prepare）后 hooks 才生效")
    }
}

function modifyPackageJson(updates, { merge = false } = {}) {
    const pkgPath = path.resolve(PROJECT_ROOT, "package.json")
    let pkg = {}
    if (fileExists("package.json")) {
        pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"))
    }

    // A generated manifest must be installable on its own: npm requires
    // name/version (e.g. running init in an empty directory).
    if (typeof pkg.name !== "string" || !pkg.name.trim()) {
        pkg.name =
            path
                .basename(PROJECT_ROOT)
                .toLowerCase()
                .replace(/[^a-z0-9._-]+/g, "-")
                .replace(/^[._-]+|[._-]+$/g, "") || "my-project"
    }
    if (typeof pkg.version !== "string" || !pkg.version.trim()) {
        pkg.version = "1.0.0"
    }

    // Merge scripts: updates won't overwrite existing scripts with the same key
    if (updates.scripts) {
        pkg.scripts = { ...updates.scripts, ...(pkg.scripts || {}) }
        // 唯一纠偏例外：standard-version 已停止维护且从未是我们的 peer，旧项目
        // 遗留的 release: standard-version 会让 pnpm release 必然 command not
        // found（下游 1.2 → 1.8.5 升级实测）。其余自定义脚本仍尊重不覆盖。
        if (
            typeof pkg.scripts.release === "string" &&
            pkg.scripts.release.includes("standard-version")
        ) {
            pkg.scripts.release = updates.scripts.release
            console.log("      ✓ release 脚本已从 standard-version 纠偏为 commit-and-tag-version")
        }
    }

    // Set lint-staged (replace existing lint-staged to avoid stale/duplicate patterns)
    // --merge 例外：用户已有分组原样保留，只补缺失
    if (updates["lint-staged"] && !(merge && pkg["lint-staged"])) {
        pkg["lint-staged"] = updates["lint-staged"]
    }

    // Keep the project's own indentation (a 2-space repo should not be reflowed)
    const previous = fileExists("package.json") ? fs.readFileSync(pkgPath, "utf8") : ""
    const indentMatch = previous.match(/^[ \t]+(?=")/m)
    fs.writeFileSync(
        pkgPath,
        JSON.stringify(pkg, null, indentMatch ? indentMatch[0] : 4) + "\n",
        "utf8",
    )
}

function checkPeerDeps({
    useFlatConfig = false,
    cssPreprocessor = "scss",
    projectType = "base",
} = {}) {
    const pkg = getProjectPkg()
    if (!pkg) return 0

    // If running within the package itself, skip external missing deps check
    if (pkg.name === "my-code-style") {
        return 0
    }

    const baseDeps = [
        "eslint",
        // Required by @typescript-eslint/parser and typescript-eslint at runtime
        "typescript",
        "prettier",
        ...(projectType !== "base" ? ["eslint-plugin-vue"] : []),
        "@commitlint/cli",
        "@commitlint/config-conventional",
        "husky",
        "lint-staged",
        "czg",
        "commit-and-tag-version",
    ]

    const flatDeps = useFlatConfig
        ? [
              "typescript-eslint",
              "eslint-import-resolver-typescript",
              ...(projectType !== "base" ? ["vue-eslint-parser"] : []),
              "globals",
              "eslint-plugin-import-x",
              "@eslint/js",
              "eslint-plugin-prettier",
              "eslint-config-prettier",
          ]
        : [
              "@typescript-eslint/parser",
              "@typescript-eslint/eslint-plugin",
              ...(projectType !== "base" ? ["vue-eslint-parser"] : []),
              "eslint-plugin-import",
              "eslint-import-resolver-typescript",
              "eslint-plugin-prettier",
              "eslint-config-prettier",
          ]

    const cssDeps =
        cssPreprocessor === "both"
            ? [
                  "stylelint",
                  "postcss-scss",
                  "postcss-less",
                  "postcss-html",
                  "stylelint-config-recommended",
                  "stylelint-config-recommended-scss",
                  "stylelint-config-recommended-vue",
                  "stylelint-config-html",
                  "stylelint-config-recess-order",
                  "stylelint-prettier",
              ]
            : cssPreprocessor === "scss"
              ? [
                    "stylelint",
                    "postcss-scss",
                    "postcss-html",
                    "stylelint-config-recommended",
                    "stylelint-config-recommended-scss",
                    "stylelint-config-recommended-vue",
                    "stylelint-config-html",
                    "stylelint-config-recess-order",
                    "stylelint-prettier",
                ]
              : cssPreprocessor === "less"
                ? [
                      "stylelint",
                      "postcss-less",
                      "postcss-html",
                      "stylelint-config-recommended",
                      "stylelint-config-recommended-vue",
                      "stylelint-config-html",
                      "stylelint-config-recess-order",
                      "stylelint-prettier",
                  ]
                : []

    const allPeerDeps = [...baseDeps, ...flatDeps, ...cssDeps]

    // Read peer dependency versions from my-code-style package.json
    const packagePkg = JSON.parse(
        fs.readFileSync(path.resolve(PACKAGE_DIR, "package.json"), "utf8"),
    )
    const peerDeps = packagePkg.peerDependencies || {}

    const allDeps = {
        ...(pkg.dependencies || {}),
        ...(pkg.devDependencies || {}),
    }

    const versionProblems = checkInstalledVersions({ peerDeps, allPeerDeps })

    const missing = allPeerDeps.filter((dep) => !allDeps[dep])
    if (missing.length > 0) {
        console.log("")
        warn(`以下依赖未安装（${missing.length} 个）：${missing.join(", ")}`)
        console.log("")
        warn("一键安装命令（可整段粘贴执行）：")
        console.log(`        ${addDevCommand(detectPackageManager())} my-code-style \\`)
        missing.forEach((dep, i) => {
            const version =
                dep === "eslint" ? (useFlatConfig ? "^9.0.0" : "^8.57.0") : peerDeps[dep] || ""
            const depWithVersion = shellSafeSpec(version ? `${dep}@${version}` : dep)
            const suffix = i < missing.length - 1 ? " \\" : ""
            console.log(`          ${depWithVersion}${suffix}`)
        })
    }
    return missing.length + versionProblems
}

// 体检时会顺着这些包的 peerDependencies 反查底层依赖的实际版本
const PEER_SOURCE_PACKAGES = [
    "stylelint-config-recommended",
    "stylelint-config-recommended-scss",
    "stylelint-config-recommended-vue",
    "stylelint-config-html",
    "stylelint-config-recess-order",
    "stylelint-prettier",
]
// 只反查这些“装错就真的会坏”的底层包，避免把上游配置之间的宽松约束也报出来
const PEER_SOURCE_TARGETS = [
    "stylelint",
    "stylelint-order",
    "postcss-html",
    "stylelint-config-recommended",
    "stylelint-config-html",
    "stylelint-config-recommended-scss",
]

/**
 * 已装依赖的版本体检。
 *
 * 为什么需要它：npm 遇到不满足的 peer 会直接 ERESOLVE 拒装，pnpm 只打印一行
 * WARN 就装完，于是“装是装上了，跑起来才坏”的组合会长期潜伏。这里把两类问题
 * 主动查出来并给出对齐命令（只做 major 级别判断，保持零依赖）：
 *   1. 我们声明的 peer 范围 vs 项目里实际安装的版本（含 minor / patch）；
 *   2. 上游配置包自己的 peer（例如 stylelint-config-recommended@18 要求
 *      stylelint ^17），以及 typescript-eslint 与其 parser/plugin 的版本错位。
 */
function checkInstalledVersions({ peerDeps, allPeerDeps, rootDir = PROJECT_ROOT }) {
    const problems = []
    const seen = new Set()
    const add = (name, message, target) => {
        const key = `${name}\u0000${message}`
        if (seen.has(key)) return
        seen.add(key)
        problems.push({ name, message, target })
    }
    const minorOf = (version) => String(version).split(".").slice(0, 2).join(".")

    // 1) 本工具的 peer 范围 vs 实际安装
    for (const dep of allPeerDeps) {
        const range = dep === "eslint" ? peerDeps.eslint : peerDeps[dep]
        if (!range || range === "*" || range.startsWith("npm:")) continue
        const installed = findInstalledPackage(dep, rootDir)
        if (!installed) continue
        const allowed = satisfiesRange(range, installed.version)
        if (allowed === null || allowed) continue
        add(dep, `${dep} 装了 ${installed.version}，本工具要求 ${range}`, `${dep}@${range}`)
    }

    // 2) 上游配置包的 peer vs 实际安装（配置文件本身也会挑底层版本）
    for (const dep of PEER_SOURCE_PACKAGES) {
        const source = findInstalledPackage(dep, rootDir)
        if (!source) continue
        for (const [target, range] of Object.entries(source.manifest.peerDependencies || {})) {
            if (!PEER_SOURCE_TARGETS.includes(target)) continue
            if (range === "*" || String(range).startsWith("npm:")) continue
            const installed = findInstalledPackage(target, rootDir)
            if (!installed) {
                if (!rangeIntervals(range).length) continue
                add(
                    target,
                    `${dep}@${source.version} 需要 ${target}@${range}，项目里没有安装`,
                    `${target}@${range}`,
                )
                continue
            }
            const allowed = satisfiesRange(range, installed.version)
            if (allowed === null || allowed) continue
            add(
                target,
                `${dep}@${source.version} 要求 ${target}@${range}，实际装了 ${installed.version}`,
                `${target}@${range}`,
            )
        }
    }

    // 3) typescript-eslint 与 @typescript-eslint/parser、eslint-plugin 必须同版本
    const meta = findInstalledPackage("typescript-eslint", rootDir)
    if (meta) {
        for (const sibling of ["@typescript-eslint/parser", "@typescript-eslint/eslint-plugin"]) {
            const installed = findInstalledPackage(sibling, rootDir)
            if (!installed) continue
            if (minorOf(installed.version) === minorOf(meta.version)) continue
            add(
                sibling,
                `${sibling}@${installed.version} 与 typescript-eslint@${meta.version} 不是同一版本`,
                `${sibling}@${meta.version}`,
            )
        }
    }

    if (!problems.length) return 0
    console.log("")
    warn(`以下依赖已安装，但版本与当前配置不匹配（${problems.length} 个）：`)
    for (const problem of problems) console.log(`      · ${problem.message}`)
    console.log("")
    warn("对齐命令（可整段粘贴执行；也可以把上游配置包降到匹配的大版本）：")
    const targets = [...new Set(problems.map((problem) => problem.target))]
    console.log(
        `        ${addDevCommand(detectPackageManager())} ${targets.map(shellSafeSpec).join(" ")}`,
    )
    return problems.length
}

// Only run when executed directly; requiring this file must be side-effect free.
if (require.main === module) {
    main()
}
